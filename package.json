{
  "name": "article-reader-extension",
  "private": true,
  "version": "1.0.1",
  "description": "A private, local-first Firefox reader with on-device translation, highlights, notes, references, and optional AI tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdTears619/article-reader-firefox.git"
  },
  "homepage": "https://github.com/ColdTears619/article-reader-firefox#readme",
  "bugs": {
    "url": "https://github.com/ColdTears619/article-reader-firefox/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode pages",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && vite build --mode pages && vite build --mode background && vite build --mode content",
    "package": "npm run build && cd dist && zip -FS -r ../article-reader-firefox.zip .",
    "package:source": "git archive --format=zip --output=article-reader-firefox-source.zip HEAD",
    "package:amo": "npm run package && npm run package:source"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.6",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/webextension-polyfill": "^0.12.3",
    "eslint": "^9.32.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^4.1.12"
  }
}
